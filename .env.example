# ─── Sui access (gRPC-Web; JSON-RPC is retired) ───
# Provider base URL. Alchemy: https://sui-mainnet.g.alchemy.com (set SUI_GRPC_BEARER to your key)
# BlockVision: https://sui-mainnet-grpc.blockvision.org (set SUI_GRPC_API_KEY). Unset = public
# fullnode (rate limited, dev only).
SUI_GRPC_URL=
SUI_GRPC_BEARER=
SUI_GRPC_API_KEY=

# Legacy (JSON-RPC, no longer used by the app after the gRPC migration)
ALCHEMY_SUI_RPC=https://sui-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DATABASE_URL=postgresql://user:password@host:5432/navi_dashboard

# Optional: Cron authentication
CRON_SECRET=your-random-secret-here

# Optional: Upstash QStash (for scheduled crons on free tier)
QSTASH_TOKEN=your-qstash-token

# Optional: App URL (for QStash setup)
APP_URL=https://your-app.vercel.app

# ─── Email Gate (Beehiiv) ───
# Required for the EmailGate /api/subscribe proxy.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
